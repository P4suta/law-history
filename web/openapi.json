  "components": {
    "schemas": {
      "Adjustment": {
        "type": "object",
        "required": [
          "target_step",
          "expected_operations_sha256",
          "replacement"
        ],
        "properties": {
          "expected_operations_sha256": {
            "type": "string"
          },
          "replacement": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SourcedOperation"
            }
          },
          "target_step": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "AmendmentInput": {
        "type": "object",
        "required": [
          "law_id",
          "base_version",
          "text",
          "source_url"
        ],
        "properties": {
          "base_version": {
            "type": "string"
          },
          "law_id": {
            "type": "string"
          },
          "source_url": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "AmendmentStep": {
        "type": "object",
        "required": [
          "id",
          "effective"
        ],
        "properties": {
          "adjustments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Adjustment"
            }
          },
          "after": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "effective": {
            "$ref": "#/components/schemas/LegalDate"
          },
          "id": {
            "type": "string"
          },
          "operations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SourcedOperation"
            }
          }
        },
        "additionalProperties": false
      },
      "Bill": {
        "type": "object",
        "required": [
          "schema_version",
          "id",
          "title",
          "enacted_law_ids",
          "submitters",
          "reason",
          "speeches",
          "source"
        ],
        "properties": {
          "enacted_law_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "id": {
            "$ref": "#/components/schemas/BillId"
          },
          "reason": {
            "type": "string"
          },
          "schema_version": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "source": {
            "$ref": "#/components/schemas/Provenance"
          },
          "speeches": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SpeechLink"
            }
          },
          "submitters": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "title": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "BillId": {
        "type": "object",
        "required": [
          "house",
          "kind",
          "session",
          "number"
        ],
        "properties": {
          "house": {
            "$ref": "#/components/schemas/House"
          },
          "kind": {
            "$ref": "#/components/schemas/BillKind"
          },
          "number": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "session": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "BillKind": {
        "type": "string",
        "enum": [
          "cabinet",
          "representatives",
          "councillors",
          "budget",
          "treaty",
          "approval",
          "consent",
          "accounts",
          "resolution",
          "rules",
          "regulations"
        ]
      },
      "BlameEntry": {
        "type": "object",
        "required": [
          "path",
          "version",
          "source",
          "diagnostics"
        ],
        "properties": {
          "diagnostics": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Diagnostic"
            }
          },
          "path": {
            "type": "string"
          },
          "previous_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "$ref": "#/components/schemas/Provenance"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "Catalog": {
        "type": "object",
        "required": [
          "schema_version",
          "collected_at",
          "source_url",
          "reported_count",
          "law_ids",
          "complete"
        ],
        "properties": {
          "collected_at": {
            "type": "string",
            "format": "date-time"
          },
          "complete": {
            "type": "boolean"
          },
          "law_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reported_count": {
            "type": "integer",
            "minimum": 0
          },
          "schema_version": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "source_url": {
            "type": "string"
          }
        }
      },
      "Change": {
        "type": "object",
        "required": [
          "kind"
        ],
        "properties": {
          "after": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/LocatedElement"
              }
            ]
          },
          "before": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/LocatedElement"
              }
            ]
          },
          "evidence": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Provenance"
              }
            ]
          },
          "kind": {
            "$ref": "#/components/schemas/ChangeKind"
          }
        }
      },
      "ChangeKind": {
        "type": "string",
        "enum": [
          "added",
          "removed",
          "changed",
          "moved",
          "renumbered"
        ]
      },
      "Confidence": {
        "type": "string",
        "enum": [
          "official",
          "reconstructed",
          "inferred",
          "synthetic"
        ]
      },
      "Content": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "value",
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "text"
                ]
              },
              "value": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "value",
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "element"
                ]
              },
              "value": {
                "$ref": "#/components/schemas/Element"
              }
            }
          }
        ]
      },
      "Coverage": {
        "type": "object",
        "required": [
          "law_id",
          "stored_revisions",
          "enactment_known",
          "all_available_stored",
          "diagnostics"
        ],
        "properties": {
          "all_available_stored": {
            "type": "boolean"
          },
          "available_revisions": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "diagnostics": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Diagnostic"
            }
          },
          "earliest_known": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Day"
              }
            ]
          },
          "enactment_known": {
            "type": "boolean"
          },
          "last_collected": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "law_id": {
            "type": "string"
          },
          "stored_revisions": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "Day": {
        "type": "string",
        "example": "1969-12-31"
      },
      "Diagnostic": {
        "type": "object",
        "required": [
          "code",
          "message",
          "source",
          "locator"
        ],
        "properties": {
          "code": {
            "$ref": "#/components/schemas/DiagnosticCode"
          },
          "locator": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      },
      "DiagnosticCode": {
        "type": "string",
        "enum": [
          "unknown_date",
          "ambiguous_order",
          "missing_source",
          "unsupported_syntax",
          "wrong_base",
          "original_mismatch",
          "conflict",
          "official_mismatch",
          "unresolved_reference",
          "coverage_gap",
          "invalid_input"
        ]
      },
      "Diff": {
        "type": "object",
        "required": [
          "from",
          "to",
          "changes",
          "diagnostics"
        ],
        "properties": {
          "changes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Change"
            }
          },
          "diagnostics": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Diagnostic"
            }
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        }
      },
      "Element": {
        "type": "object",
        "required": [
          "tag"
        ],
        "properties": {
          "attributes": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Content"
            }
          },
          "tag": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ErrorBody": {
        "type": "object",
        "required": [
          "error",
          "diagnostics"
        ],
        "properties": {
          "diagnostics": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Diagnostic"
            }
          },
          "error": {
            "type": "string"
          }
        }
      },
      "House": {
        "type": "string",
        "enum": [
          "representatives",
          "councillors"
        ]
      },
      "Impact": {
        "type": "object",
        "required": [
          "context_versions",
          "direct",
          "review",
          "broken",
          "diagnostics"
        ],
        "properties": {
          "broken": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Reference"
            }
          },
          "context_versions": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "diagnostics": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Diagnostic"
            }
          },
          "direct": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Position"
            }
          },
          "review": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReviewPath"
            }
          }
        }
      },
